# Input: one full-length viral nucleotide sequence per TaxID in each class.
INSECT_FASTA="input/full_length/Insect_full_length.fasta"
PLANT_FASTA="input/full_length/Plant_full_length.fasta"
OTHER_FASTA="input/full_length/Other_full_length.fasta"

# Slicing mode: regenerate (fresh deterministic windows) or historical (frozen original windows).
SLICING_MODE="regenerate"
SLICE_SEED=""
HISTORICAL_FRAGMENTS=""

# Official upstream LucaVirusTasks checkout. The installer clones it here.
LUCAVIRUS_TASKS="external/LucaVirusTasks"
# Optional exact commit/hash pin. For strict manuscript reproduction these must be audited.
LUCAVIRUS_COMMIT=""
LUCAVIRUS_CHECKPOINT_PATH=""
LUCAVIRUS_CHECKPOINT_SHA256=""

ESM2_BATCH_SIZE="16"
ESM2_DEVICE="auto"
LUCAVIRUS_GPU_ID="-1"
LUCAVIRUS_CHUNK_SIZE="250"

# Require original historical class counts; set 0 for a newly collected dataset.
EXPECT_PUBLISHED="1"
# An exact Figure 5 comparison failure stops the run only if this is 1.
STRICT_REFERENCE="0"
FIT_DEPLOY_MODELS="1"
